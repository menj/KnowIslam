{{{html-headelement}}}
<a class="ki-skip" href="#content">{{msg-knowislam-skip}}</a>
<div class="ki-site">
	<header class="ki-header">
		<div class="ki-header__inner">
			<details class="ki-menu">
				<summary class="ki-iconbtn" aria-label="{{msg-knowislam-menu}}" title="{{msg-knowislam-menu}}"><span class="ki-burger"></span></summary>
				<div class="ki-menu__panel">
					{{#data-portlets-sidebar}}
						{{#data-portlets-first}}{{>Portlet}}{{/data-portlets-first}}
						{{#array-portlets-rest}}{{>Portlet}}{{/array-portlets-rest}}
					{{/data-portlets-sidebar}}
				</div>
			</details>
			<a class="ki-brand" href="{{link-mainpage}}">{{#ki-logo-url}}<img class="ki-brand-logo" src="{{ki-logo-url}}" alt="" width="44" height="44">{{/ki-logo-url}}<span class="ki-brand-name">{{msg-sitetitle}}<small>{{msg-knowislam-tagline}}</small></span></a>
			{{#data-search-box}}
			<form class="ki-search" action="{{form-action}}" role="search">
				<input type="hidden" name="title" value="Special:Search">
				{{{html-input}}}
				{{{html-button-search-fallback}}}
				{{{html-button-search}}}
			</form>
			{{/data-search-box}}
			<button class="ki-iconbtn ki-search-open" type="button" aria-label="{{msg-knowislam-search-open}}" title="{{msg-knowislam-search-open}}" aria-expanded="false" aria-controls="ki-search-overlay" hidden>
				<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="8.5" cy="8.5" r="5.5" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="m13 13 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
			</button>
			<button class="ki-iconbtn ki-scheme-toggle" type="button" hidden></button>
			<details class="ki-menu ki-user">
				<summary class="ki-iconbtn" aria-label="{{msg-knowislam-user-menu}}" title="{{msg-knowislam-user-menu}}">
					<svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><circle cx="10" cy="6.5" r="3.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3.5 17.5c.8-3.3 3.4-5 6.5-5s5.7 1.7 6.5 5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
				</summary>
				<div class="ki-menu__panel ki-menu__panel--end">
					{{#data-portlets}}{{#data-personal}}{{>Portlet}}{{/data-personal}}{{/data-portlets}}
				</div>
			</details>
		</div>
	</header>
	<div class="ki-search-overlay" id="ki-search-overlay" role="dialog" aria-modal="true" aria-labelledby="ki-search-overlay-title" hidden>
		<div class="ki-search-overlay__panel">
			<button class="ki-search-close ki-iconbtn" type="button" aria-label="{{msg-knowislam-search-close}}">×</button>
			<p class="ki-kicker">{{msg-knowislam-search-kicker}}</p>
			<h2 id="ki-search-overlay-title">{{msg-knowislam-search-heading}}</h2>
			<form action="{{ki-search-action}}" role="search">
				<input type="hidden" name="title" value="Special:Search">
				<label for="ki-overlay-search">{{msg-knowislam-search-label}}</label>
				<div class="ki-overlay-form"><input id="ki-overlay-search" name="search" type="search" placeholder="{{msg-knowislam-search-placeholder}}" required><button type="submit">{{msg-knowislam-search-button}}</button></div>
			</form>
		</div>
	</div>
	{{#is-mainpage}}
	<section class="ki-landing" aria-labelledby="ki-landing-title">
		<div class="ki-landing__hero">
			<div class="ki-landing__content">
				<p class="ki-kicker">{{msg-knowislam-hero-kicker}}</p>
				<h1 id="ki-landing-title">{{msg-knowislam-hero-title}} <em>{{msg-knowislam-hero-title-em}}</em></h1>
				<p>{{msg-knowislam-hero-text}}</p>
				<form action="{{ki-search-action}}" class="ki-landing__search" role="search">
					<input type="hidden" name="title" value="Special:Search">
					<label class="ki-visually-hidden" for="ki-landing-search">{{msg-knowislam-search-label}}</label>
					<input id="ki-landing-search" type="search" name="search" placeholder="{{msg-knowislam-hero-placeholder}}" required>
					<button type="submit">{{msg-knowislam-hero-button}}</button>
				</form>
				<div class="ki-landing__quick"><span>{{msg-knowislam-hero-quick}}</span><a href="{{ki-allpages-url}}">{{msg-knowislam-allpages}} ↗</a><a href="{{ki-random-url}}">{{msg-knowislam-random}} ↗</a></div>
			</div>
			{{#ki-logo-url}}<div class="ki-landing__art" aria-hidden="true"><div class="ki-landing__arch"><img class="ki-landing__logo" src="{{ki-logo-url}}" alt=""></div></div>{{/ki-logo-url}}
		</div>
		{{#has-ki-topics}}
		<div class="ki-landing__topics">
			<div class="ki-landing__heading"><div><p class="ki-kicker">{{msg-knowislam-topics-kicker}}</p><h2>{{msg-knowislam-topics-heading}}</h2></div><a href="{{ki-allpages-url}}">{{msg-knowislam-allpages}} ↗</a></div>
			<div class="ki-landing__grid">
				{{#array-ki-topics}}
				<a href="{{href}}" class="ki-topic"><span class="ki-topic__number">{{number}}</span><span class="ki-topic__symbol" aria-hidden="true">{{symbol}}</span><strong>{{title}}</strong><span>{{text}}</span><b aria-hidden="true">↗</b></a>
				{{/array-ki-topics}}
			</div>
		</div>
		{{/has-ki-topics}}
	</section>
	{{/is-mainpage}}
	<main class="ki-main">
		<article id="content" class="mw-body" role="main">
			<div class="ki-tabs">
				{{#data-portlets}}
					{{#data-namespaces}}{{>Portlet}}{{/data-namespaces}}
					{{#data-views}}{{>Portlet}}{{/data-views}}
					{{#data-actions}}{{>Portlet}}{{/data-actions}}
				{{/data-portlets}}
			</div>
			{{{html-sitenotice}}}
			{{{html-indicators}}}
			{{^is-mainpage}}{{{html-title-heading}}}{{/is-mainpage}}
			{{{html-subtitle}}}
			{{{html-undelete-link}}}
			{{{html-user-message}}}
			<div id="bodyContent" class="mw-body-content">
				{{{html-body-content}}}
			</div>
			{{{html-catlinks}}}
			{{{html-after-content}}}
		</article>
	</main>
	{{#data-footer}}
	<footer class="ki-footer">
		{{#data-info}}<ul>{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>{{/data-info}}
		{{#data-places}}<ul>{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>{{/data-places}}
		{{#data-icons}}<ul class="ki-footer__icons">{{#array-items}}<li id="{{id}}">{{{html}}}</li>{{/array-items}}</ul>{{/data-icons}}
	</footer>
	{{/data-footer}}
</div>
{{{html-printtail}}}
