{
	"name": "KnowIslam",
	"namemsg": "skinname-knowislam",
	"version": "1.2.0",
	"author": [
		"Mohd Elfie Nieshaem Juferi"
	],
	"url": "https://github.com/menj/KnowIslam",
	"descriptionmsg": "knowislam-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.39.0"
	},
	"manifest_version": 2,
	"ValidSkinNames": {
		"knowislam": {
			"displayname": "Know Islam",
			"class": "MediaWiki\\Skins\\KnowIslam\\SkinKnowIslam",
			"args": [
				{
					"name": "knowislam",
					"responsive": true,
					"templateDirectory": "templates",
					"styles": [
						"skins.knowislam.styles"
					],
					"scripts": [
						"skins.knowislam.js"
					],
					"messages": [
						"sitetitle",
						"knowislam-skip",
						"knowislam-menu",
						"knowislam-user-menu",
						"knowislam-tagline",
						"knowislam-search-open",
						"knowislam-search-close",
						"knowislam-search-kicker",
						"knowislam-search-heading",
						"knowislam-search-label",
						"knowislam-search-placeholder",
						"knowislam-search-button",
						"knowislam-hero-kicker",
						"knowislam-hero-title",
						"knowislam-hero-title-em",
						"knowislam-hero-text",
						"knowislam-hero-placeholder",
						"knowislam-hero-button",
						"knowislam-hero-quick",
						"knowislam-allpages",
						"knowislam-random",
						"knowislam-topics-kicker",
						"knowislam-topics-heading"
					]
				}
			]
		}
	},
	"config": {
		"KnowIslamCustomColors": {
			"value": {},
			"description": "Optional map of CSS variable names (--ki-*) to colour values, applied site-wide."
		}
	},
	"DefaultUserOptions": {
		"knowislam-scheme": "auto",
		"knowislam-accent": "emerald",
		"knowislam-size": "medium",
		"knowislam-width": "standard"
	},
	"AutoloadNamespaces": {
		"MediaWiki\\Skins\\KnowIslam\\": "includes/"
	},
	"HookHandlers": {
		"main": {
			"class": "MediaWiki\\Skins\\KnowIslam\\Hooks"
		}
	},
	"Hooks": {
		"GetPreferences": "main",
		"OutputPageBodyAttributes": "main",
		"BeforePageDisplay": "main"
	},
	"MessagesDirs": {
		"KnowIslam": [
			"i18n"
		]
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "KnowIslam"
	},
	"ResourceModules": {
		"skins.knowislam.styles": {
			"styles": [
				"css/themes.css",
				"css/base.css",
				"css/components.css",
				"css/content.css",
				"css/landing.css"
			]
		},
		"skins.knowislam.js": {
			"scripts": [
				"js/theme-toggle.js",
				"js/menu.js",
				"js/search-overlay.js"
			],
			"messages": [
				"knowislam-toggle-scheme"
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.user"
			]
		}
	}
}
